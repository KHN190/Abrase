const HDR_FRONTIER: Int = 0;
const HDR_SIZE: Int = 8;
const HDR_FREELIST: Int = 16;
const GLOBAL_HDR: Int = 32;
const BLK_HDR: Int = 24;
const BLK_NEXT: Int = 16;
const WORD_BYTES: Int = 8;
const WORD_BITS: Int = 64;

// @word:start
fn load_word(addr: Addr) -> <core> Int { __peek64(addr) }
fn store_word(addr: Addr, value: Int) -> <core> Unit { __poke64(addr, value) }
// @word:end

fn at(off: Int) -> <core> Addr { __ptr_add(__arena_base(), off) }
fn mask_words(size: Int) -> <core> Int { (size + WORD_BITS - 1) / WORD_BITS }
fn blk_bytes(size: Int) -> <core> Int { BLK_HDR + mask_words(size) * WORD_BYTES + size * WORD_BYTES }
fn data_start(off: Int, size: Int) -> <core> Int { off + BLK_HDR + mask_words(size) * WORD_BYTES }

// @codec:start
fn enc(off: Int, gen: Int) -> <core> Int { (off << 24) | (gen & 16777215) }
fn blk_off(h: Int) -> <core> Int { h >> 24 }

fn chk(h: Int) -> <core> Int {
    let off = blk_off(h);
    if off < GLOBAL_HDR {
        0 - 1
    } else {
        if (__peek32(at(off + 4)) & 16777215) != (h & 16777215) { 0 - 1 } else { off }
    }
}

fn heap_start() -> <core> Int { GLOBAL_HDR }
fn binding_available() -> <core> Int { 1 }
fn binding_release(h: Int) -> <core> Unit { () }
fn block_released(off: Int) -> <core> Unit {
    __poke32(at(off + 4), __peek32(at(off + 4)) + 1)
}
// @codec:end

fn mask_word_off(off: Int, i: Int) -> <core> Int { off + BLK_HDR + (i / WORD_BITS) * WORD_BYTES }
fn test_mask(off: Int, i: Int) -> <core> Int {
    (load_word(at(mask_word_off(off, i))) >> (i & (WORD_BITS - 1))) & 1
}
fn set_mask(off: Int, i: Int) -> <core> Unit {
    let w = mask_word_off(off, i);
    store_word(at(w), load_word(at(w)) | (1 << (i & (WORD_BITS - 1))))
}
fn clr_mask(off: Int, i: Int) -> <core> Unit {
    let w = mask_word_off(off, i);
    store_word(at(w), load_word(at(w)) & (0 - 1 - (1 << (i & (WORD_BITS - 1)))))
}
fn clear_mask(off: Int, size: Int) -> <core> Unit {
    let mw = mask_words(size);
    let mut j = 0;
    while j < mw {
        store_word(at(off + BLK_HDR + j * WORD_BYTES), 0);
        j = j + 1;
    }
}
fn clear_data(off: Int, size: Int) -> <core> Unit {
    let ds = data_start(off, size);
    let mut j = 0;
    while j < size {
        store_word(at(ds + j * WORD_BYTES), 0 - 1);
        j = j + 1;
    }
}
fn prep_block(off: Int, size: Int) -> <core> Unit {
    __poke32(at(off), 1);
    clear_mask(off, size);
    clear_data(off, size)
}

// @init:start
pub fn core_init(size: Int) -> <core> Unit {
    store_word(at(HDR_FRONTIER), heap_start());
    store_word(at(HDR_SIZE), size);
    store_word(at(HDR_FREELIST), 0)
}

// @init:end

fn bump_alloc(size: Int) -> <core> Int {
    let frontier = load_word(at(HDR_FRONTIER));
    let need = blk_bytes(size);
    let arena = load_word(at(HDR_SIZE));
    if need > arena - frontier {
        0
    } else {
        __poke32(at(frontier + 4), 0);
        __poke32(at(frontier + 8), size);
        prep_block(frontier, size);
        store_word(at(HDR_FRONTIER), frontier + need);
        enc(frontier, 0)
    }
}

pub fn alloc(size: Int) -> <core> Int {
    if size < 0 || size > 268435456 || binding_available() == 0 {
        0
    } else {
        let mut prev = 0 - 1;
        let mut cur = load_word(at(HDR_FREELIST));
        let mut found = 0 - 1;
        while cur != 0 {
            let next = load_word(at(cur + BLK_NEXT));
            if found < 0 && __peek32(at(cur + 8)) == size {
                if prev < 0 {
                    store_word(at(HDR_FREELIST), next);
                    ()
                } else {
                    store_word(at(prev + BLK_NEXT), next);
                    ()
                };
                found = cur;
                cur = 0;
                ()
            } else {
                prev = cur;
                cur = next;
                ()
            };
        }
        if found < 0 {
            bump_alloc(size)
        } else {
            prep_block(found, size);
            enc(found, __peek32(at(found + 4)))
        }
    }
}

fn free(h: Int, off: Int) -> <core> Unit {
    binding_release(h);
    let size = __peek32(at(off + 8));
    let mut i = 0;
    while i < size {
        if test_mask(off, i) == 1 {
            rc_dec(load_word(at(data_start(off, size) + i * WORD_BYTES)));
            ()
        } else {
            ()
        };
        i = i + 1;
    }
    block_released(off);
    let head = load_word(at(HDR_FREELIST));
    store_word(at(off + BLK_NEXT), head);
    store_word(at(HDR_FREELIST), off)
}

pub fn cell_get(h: Int, i: Int) -> <core> Int {
    let off = chk(h);
    if off < 0 {
        0 - 1
    } else {
        let size = __peek32(at(off + 8));
        if i < 0 || i >= size {
            0 - 1
        } else {
            load_word(at(data_start(off, size) + i * WORD_BYTES))
        }
    }
}

pub fn cell_set(h: Int, i: Int, v: Int) -> <core> Int {
    let off = chk(h);
    if off < 0 {
        0 - 1
    } else {
        let size = __peek32(at(off + 8));
        if i < 0 || i >= size {
            0 - 1
        } else {
            store_word(at(data_start(off, size) + i * WORD_BYTES), v);
            clr_mask(off, i);
            0
        }
    }
}

pub fn cell_set_child(h: Int, i: Int, child: Int) -> <core> Int {
    let off = chk(h);
    if off < 0 {
        0 - 1
    } else {
        let size = __peek32(at(off + 8));
        if i < 0 || i >= size {
            0 - 1
        } else {
            store_word(at(data_start(off, size) + i * WORD_BYTES), child);
            set_mask(off, i);
            0
        }
    }
}

pub fn rc_inc(h: Int) -> <core> Int {
    let off = chk(h);
    if off < 0 {
        0 - 1
    } else {
        __poke32(at(off), __peek32(at(off)) + 1);
        0
    }
}

pub fn rc_dec(h: Int) -> <core> Int {
    let off = chk(h);
    if off < 0 {
        0 - 1
    } else {
        let rc = __peek32(at(off)) - 1;
        __poke32(at(off), rc);
        if rc == 0 {
            free(h, off);
            1
        } else {
            0
        }
    }
}

pub fn force_free(h: Int) -> <core> Int {
    let off = chk(h);
    if off < 0 {
        0
    } else {
        __poke32(at(off), 1);
        rc_dec(h)
    }
}
